{
  "name": "timba-oracle",
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun run --watch index.ts",
    "admin": "bun run scripts/oracle-admin.ts",
    "indexer:import": "bun run scripts/import-indexer.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "start:evm": "bun run evm/main.ts"
  },
  "dependencies": {
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@solana/kit": "8.3.0",
    "@timbagame/protocol": "0.13.0",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.70.1",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
