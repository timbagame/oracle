# Oracle API Environment Variables

# Solana Network RPC URL
SOLANA_NETWORK=https://api.mainnet-beta.solana.com

# Oracle API Server Port
ORACLE_PORT=3001

# Required shared secret for bot-to-oracle HTTP requests.
# Generate with: openssl rand -hex 32
# Production reads this from ./secrets/oracle-api-token (mode 400 or 600).
# ORACLE_API_TOKEN remains supported for local development and tests.

# Optional: path to the admin keypair JSON used by the oracle operator
# Defaults to ./admin-keypair.json if omitted
ORACLE_KEYPAIR_PATH=./admin-keypair.json

# Optional: set to "true" to generate an ephemeral admin keypair when
# the configured keypair file is missing (useful for local testing)
# USE_FAKE_KEYPAIR=true

# Optional: throttle between scanning pending games (in milliseconds)
# Defaults to 0 meaning no delay
# ORACLE_SCAN_THROTTLE_MS=0

# Optional: debounce applying on-chain player join/unjoin events to SQLite (in milliseconds)
# Helps large games avoid 10k individual writes.
# Defaults to 100
# ORACLE_PLAYER_EVENT_FLUSH_DEBOUNCE_MS=100

# Optional: max buffered join/unjoin operations before forcing an immediate flush
# Defaults to 500
# ORACLE_PLAYER_EVENT_FLUSH_MAX_OPERATIONS=500

# Optional: debounce auto-complete attempts triggered by player activity (in milliseconds)
# Defaults to 500
# ORACLE_AUTOCOMPLETE_DEBOUNCE_MS=500

# Optional: disable Solana JSON-RPC batch transaction requests (e.g., Connection.getTransactions)
# Some providers (e.g., free plans) reject batch requests with 403.
# Defaults to false
# ORACLE_DISABLE_RPC_BATCH_TRANSACTIONS=true
