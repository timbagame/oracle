# Oracle API Environment Variables

# Solana Network RPC URL
SOLANA_NETWORK=https://api.devnet.solana.com

# Oracle API Server Port
ORACLE_PORT=3001

# Security Configuration (optional)
# If set, requests to protected endpoints will require this API key
# Include in Authorization header: "Bearer YOUR_API_KEY" or as query param: ?api_key=YOUR_API_KEY
ORACLE_API_KEY=your_secret_api_key_here

# Rate Limiting (optional - defaults to 100 requests per minute)
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW=60000

# Database Configuration (optional)
# DATABASE_CLEANUP_DAYS=30

# Scanning Configuration (optional)
# SCAN_INTERVAL=30000
# MAX_RETRIES=3
# RETRY_DELAY=5000

# Monitoring Configuration (optional)
# ENABLE_METRICS=true
# LOG_LEVEL=info

# Example configuration (copy to .env and update with your values)
# The admin-keypair.json file should be in the oracle directory root
