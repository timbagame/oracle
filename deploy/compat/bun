#!/bin/sh
# Transitional stand-in for the entry points of the TypeScript (Bun) image.
#
# Hosts still running the 0.2 Quadlets probe health with `bun -e ...` and start
# the EVM oracle with `bun run start:evm`; runbooks call `bun run admin ...`.
# podman auto-update can move such a host onto this image before its Quadlets
# are replaced, so map those invocations onto the Rust binaries instead of
# failing with "bun: not found" (which HealthOnFailure=kill turns into a crash
# loop). Remove once every deployment runs the Rust Quadlets.
set -eu

fail() {
  echo "bun compatibility shim: unsupported invocation: bun $*" >&2
  exit 127
}

case "${1:-}" in
  -e | --eval)
    # The only inline script the old images ran is the /health probe.
    exec timba-oracle healthcheck
    ;;
  start)
    shift
    exec timba-oracle serve "$@"
    ;;
  run)
    [ $# -ge 2 ] || fail "$@"
    script=$2
    shift 2
    case "$script" in
      start | index.ts) exec timba-oracle serve "$@" ;;
      start:evm | evm/main.ts) exec timba-evm-oracle "$@" ;;
      admin | scripts/oracle-admin.ts) exec timba-oracle admin "$@" ;;
      indexer:import | scripts/import-indexer.ts) exec timba-oracle import-indexer "$@" ;;
      scripts/attempt-completion.ts) exec timba-oracle attempt-completion "$@" ;;
      scripts/inspect-game.ts) exec timba-oracle inspect-game "$@" ;;
      scripts/inspect-oracle.ts) exec timba-oracle inspect-oracle "$@" ;;
      scripts/audit-random.ts) exec timba-oracle audit-random "$@" ;;
      scripts/manual-shutdown.ts) exec timba-oracle manual-shutdown "$@" ;;
      *) fail run "$script" "$@" ;;
    esac
    ;;
  *) fail "$@" ;;
esac
