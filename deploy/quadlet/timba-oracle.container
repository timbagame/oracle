[Unit]
Description=Timba oracle
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/timbagame/oracle:main
ContainerName=oracle
AutoUpdate=registry
Network=timba.network
IP=10.89.0.48
EnvironmentFile=%h/timba/oracle/.env
Environment=ORACLE_PORT=3001
Environment=ORACLE_API_TOKEN_FILE=/run/secrets/oracle_api_token
Environment=JUPITER_API_KEY_FILE=/run/secrets/jupiter_api_key
Environment=OPERATOR_KEYPAIR_PATH=/run/secrets/operator_keypair.json
Environment=INDEXER_DATABASE_FILE=/app/indexer.sqlite
Volume=%h/timba/oracle/operator-keypair.json:/run/secrets/operator_keypair.json:ro,Z
Volume=%h/timba/oracle/secrets/oracle-api-token:/run/secrets/oracle_api_token:ro,Z
Volume=%h/timba/oracle/secrets/jupiter-api-key:/run/secrets/jupiter_api_key:ro,Z
Volume=%h/timba/oracle/oracle.sqlite:/app/oracle.sqlite:Z
Volume=%h/timba/oracle/indexer.sqlite:/app/indexer.sqlite:Z
NoNewPrivileges=true
DropCapability=all
PidsLimit=256
HealthCmd=/usr/local/bin/timba-oracle healthcheck
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=90

[Install]
WantedBy=default.target
